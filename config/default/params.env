# Name of the cluster, used in the SBOM storage path.
SBOM_CLUSTER=example
# Bucket where SBOMs are stored: s3://<bucket>/<prefix>/<cluster>/<namespace>/<name>/<sha>.cdx.json.gz
SBOM_BUCKET=example-sbom
SBOM_REGION=ap-southeast-2
# Image used by scanner Pods. Keep in sync with the operator image in kustomization.yaml.
SBOM_SCANNER_IMAGE=ghcr.io/skpr/sbom-operator:latest
